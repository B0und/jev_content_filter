{
  "name": "jev-content-filter",
  "version": "0.1.0",
  "description": "Local image and AI-text filtering for X, with TypeSafe Jev sexual-text checks",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "benchmark": "vite --config benchmarks/vite.config.ts benchmarks",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint --deny-warnings",
    "doctor": "react-doctor . --no-score --blocking warning -y",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test && npm run test:agent-browser",
    "check": "npm run compile && npm run lint && npm run doctor && npm run format:check && npm test && npm run test:e2e",
    "agent:browser": "node scripts/extension-agent.mjs",
    "test:agent-browser": "node --test tests/agent/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.104",
    "@ai-sdk/typesafe-ai": "3.0.13",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "4.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tensorflow/tfjs": "^4.22.0",
    "ai": "7.0.128",
    "effect": "^4.0.0-rc.118",
    "nsfwjs": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/tsgo": "0.47.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "msw": "^3.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2003",
    "puppeteer-core": "^25.12.0",
    "react-doctor": "^0.9.14",
    "typescript": "7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        ".output/**",
        ".wxt/**",
        "playwright-report/**",
        "test-results/**"
      ]
    }
  }
}
