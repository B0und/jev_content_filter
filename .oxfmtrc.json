{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**",
    "tests/fixtures/x/**/*.html",
    "package-lock.json",
    "tools/oxlint/anti-slop/**"
  ]
}
